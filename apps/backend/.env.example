# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in all values before running

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3001
NODE_ENV=development

# ============================================================
# DATABASE CONFIGURATION (MySQL)
# ============================================================
# Local development with Docker Compose:
# DATABASE_URL=mysql://root:password@localhost:3306/reachinbox
#
# Railway MySQL: Set DATABASE_URL in Railway dashboard
# Railway provides MYSQL_URL - map it to DATABASE_URL
DATABASE_URL=mysql://username:password@host:port/database_name

# ============================================================
# REDIS CONFIGURATION
# ============================================================
# Local development with Docker Compose:
# REDIS_HOST=localhost
# REDIS_PORT=6379
#
# Railway Redis: Set REDIS_URL in Railway dashboard
# Railway provides REDIS_URL automatically
# If REDIS_URL is not available, use REDIS_HOST and REDIS_PORT
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379 (optional, takes precedence)

# ============================================================
# FRONTEND URL (for CORS)
# ============================================================
# Local development:
FRONTEND_URL=http://localhost:5173
#
# Production (Vercel):
# FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# ============================================================
# SESSION SECRET (generate a random string)
# ============================================================
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-random-session-secret-at-least-32-characters-long

# ============================================================
# GOOGLE OAUTH CREDENTIALS
# ============================================================
# Get from: https://console.cloud.google.com/
# Create OAuth 2.0 Client ID
# Local callback: http://localhost:3001/auth/google/callback
# Production callback: https://your-backend.railway.app/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ============================================================
# ETHEREAL SMTP CREDENTIALS
# ============================================================
# Get from: https://ethereal.email/
# Click "Create Ethereal Account"
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-username
SMTP_PASSWORD=your-ethereal-password
SMTP_FROM=your-ethereal-email
DEFAULT_SENDER_NAME=ReachInbox

# ============================================================
# WORKER CONFIGURATION
# ============================================================
# Number of concurrent email jobs worker can process
WORKER_CONCURRENCY=5

# ============================================================
# RATE LIMITING CONFIGURATION
# ============================================================
# Minimum delay between emails (milliseconds)
DEFAULT_MIN_DELAY_MS=1000

# Maximum emails per hour per sender
DEFAULT_EMAILS_PER_HOUR=100

# ============================================================
# TEST MODE
# ============================================================
# Set to 'true' to skip actual email sending (for testing)
TEST_MODE=false
